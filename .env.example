# Contact address shown in the built web app.
PRIVACY_CONTACT_EMAIL=you@example.com

# Local development defaults to anonymous access.
BRIDGE_AUTH_MODE=off
BRIDGE_GOOGLE_CLIENT_ID=
# Generate with: openssl rand -base64 32. Rotating this key signs everyone out.
BRIDGE_AUTH_SECRET=
# Optional comma-separated list of verified email addresses.
BRIDGE_ALLOWED_EMAILS=

# Production tunnel, configured to route to http://web:80.
TUNNEL_TOKEN=

# Lowercase GitHub owner/repository, used when pulling prebuilt images.
IMAGE_REPOSITORY=your-owner/phase-out
IMAGE_TAG=latest
